# Credenciales de PagoTIC (usadas por tests de integración y ejemplos).
# Copiá este archivo a .env y completá los valores. .env está ignorado por git.
USERNAME=
PASSWORD=
GRANT_TYPE=password
CLIENT_ID=
CLIENT_SECRET=

# El cliente del SDK también acepta estas variables con prefijo PAGOTIC_:
# PAGOTIC_USERNAME=
# PAGOTIC_PASSWORD=
# PAGOTIC_CLIENT_ID=
# PAGOTIC_CLIENT_SECRET=
# PAGOTIC_AUTH_URL=https://a.paypertic.com
# PAGOTIC_API_URL=https://api.paypertic.com
# PAGOTIC_REALM=entidades
# PAGOTIC_TIMEOUT=30
# PAGOTIC_MAX_RETRIES=2
